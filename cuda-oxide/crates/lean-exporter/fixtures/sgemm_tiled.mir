        mir.goto (sum_outer, zero_i) [^scan_header] []: <(builtin.fp32, builtin.integer ui64) -> ()>

      ^scan_header(sum_inner: builtin.fp32, i: builtin.integer ui64):
        c16_u64 = mir.constant () [] [value: builtin.integer <16: ui64>]: <() -> (builtin.integer ui64)>;
