        mir.cond_br (c_wrap) [^cons_wrap_yes, ^cons_wrap_no] [builtin_operand_segment_sizes: builtin.operand_segment_sizes [1, 0, 0]]: <(builtin.integer i1) -> ()>

      ^cons_wrap_yes():
        c_par_flip = mir.bitxor (c_par, one_u32) [] []: <(builtin.integer ui32, builtin.integer ui32) -> (builtin.integer ui32)>;
        mir.goto (zero_u64, c_par_flip) [^cons_next] []: <(builtin.integer ui64, builtin.integer ui32) -> ()>

      ^cons_wrap_no():
        mir.goto (c_inc, c_par) [^cons_next] []: <(builtin.integer ui64, builtin.integer ui32) -> ()>

      ^cons_next(c_stage_n: builtin.integer ui64, c_par_n: builtin.integer ui32):
        c_tile_n = mir.add (c_tile, one_u32) [] []: <(builtin.integer ui32, builtin.integer ui32) -> (builtin.integer ui32)>;
        mir.goto (c_stage_n, c_par_n, c_tile_n) [^cons_hdr] []: <(builtin.integer ui64, builtin.integer ui32, builtin.integer ui32) -> ()>

      ^exit():
        mir.return () [] []: <() -> ()>
    }
}
